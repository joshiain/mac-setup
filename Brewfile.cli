# Shared development base for personal and server profiles. Current releases.
tap "oven-sh/bun"

# Existing Node approach; no competing runtime manager.
brew "node"
brew "oven-sh/bun/bun" # Josh still uses Bun, alongside Node.
brew "uv" # Python versions and project environments.
brew "gh"

# Portable terminal essentials; Git comes from the Command Line Tools prerequisite.
brew "ripgrep"
brew "fd"
brew "jq"

# Coding CLIs, distinct from the desktop applications.
cask "claude-code"
cask "codex"
